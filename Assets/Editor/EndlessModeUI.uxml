    <ui:GroupBox name="PauseMenu" text="GAME PAUSED" enabled="true" style="top: 20%; height: 40%; position: relative; left: 40%; width: 20%; font-size: 40px; -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-align: upper-center; border-top-width: 5px; border-right-width: 3px; border-bottom-width: 5px; border-left-width: 3px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; background-color: rgba(255, 255, 255, 0.08); margin-top: 2px; padding-top: 20px; padding-left: 10px; padding-right: 10px; padding-bottom: 20px; bottom: auto; display: none;">
