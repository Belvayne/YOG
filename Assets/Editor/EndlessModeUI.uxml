<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/EndlessModeUI.uss?fileID=7433441132597879392&amp;guid=2ee9069769b123b4a99e59ee1fd84b55&amp;type=3#EndlessModeUI" />
    <ui:ProgressBar value="22" title="HYPE METER" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); font-size: 40px; -unity-text-align: lower-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); top: 2%; width: 50%; left: 25%; right: 25%;" />
    <ui:GroupBox style="right: 10px; top: 5%; -unity-text-align: upper-right;">
        <ui:Label text="Enemies defeated" name="KillCountLabel" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); font-size: 30px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255);" />
        <ui:Label text="0" name="KillCountText" style="color: rgb(109, 229, 255); font-size: 50px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); -unity-font-style: bold;" />
