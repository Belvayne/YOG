<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/CharacterSelect.uss?fileID=7433441132597879392&amp;guid=28f5ce53a6c7b394f8025d465dca9dec&amp;type=3#CharacterSelect" />
    <ui:Label text="Character Name" name="CharacterName" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); font-size: 120px; -unity-text-align: middle-center; color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 6px; top: 50px;" />
    <ui:Label text="Character Title" name="CharacterTitle" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); -unity-text-align: middle-center; font-size: 70px; color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 5px; top: 50px;" />
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; overflow: visible; align-items: center; align-self: center; width: 70%;">
        <ui:Button name="PreviousButton" class="side-scroll-button" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Images/arrow-icon(2).png?fileID=2800000&amp;guid=3506b970291e163479cdfed28aa56b04&amp;type=3#arrow-icon(2)&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        <ui:Button name="NextButton" class="side-scroll-button" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Images/arrow-icon(2).png?fileID=2800000&amp;guid=3506b970291e163479cdfed28aa56b04&amp;type=3#arrow-icon(2)&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
    </ui:VisualElement>
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: center; justify-content: space-between; -unity-text-align: upper-left; align-items: flex-end; align-content: flex-start; position: absolute; top: auto; left: auto; bottom: 15%; right: auto; width: 250px;">
        <ui:RadioButton enabled="true" name="KiaraRadio" focusable="false" style="height: 25px; background-color: rgba(0, 0, 0, 0); -unity-text-outline-color: rgba(0, 0, 0, 0); color: rgb(27, 27, 27);" />
        <ui:RadioButton name="CallieRadio" picking-mode="Ignore" focusable="false" style="height: 25px;" />
        <ui:RadioButton name="GuraRadio" focusable="false" picking-mode="Ignore" style="height: 25px;" />
        <ui:RadioButton name="InaRadio" picking-mode="Ignore" focusable="false" style="height: 25px;" />
        <ui:RadioButton name="AmeRadio" picking-mode="Ignore" focusable="false" style="height: 25px;" />
    </ui:VisualElement>
    <ui:Button text="CONFIRM CHARACTER" selectable="false" name="CharacterConfirmButton" focusable="false" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); font-size: 49px; color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px; width: auto; white-space: normal; -unity-text-align: upper-center; text-overflow: clip; left: auto; right: auto; position: relative; top: auto; bottom: auto; align-items: auto; justify-content: flex-start; align-self: center; align-content: auto; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; background-color: rgba(255, 255, 255, 0.63); letter-spacing: 10px; word-spacing: 0; background-position-x: center; background-position-y: center; height: auto; padding-left: 12px; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; margin-top: 2.5%; margin-bottom: 2.5%;" />
</ui:UXML>
