<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox style="top: 5%;">
        <ui:Label text="SETTINGS" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); font-size: 70px; color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-align: upper-center; top: auto;" />
        <ui:ScrollView style="width: 40%; left: 30%; background-color: rgba(0, 0, 0, 0.63); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
            <ui:GroupBox style="flex-direction: row;">
                <ui:Slider name="MasterSlider" label="MASTER VOLUME" value="100" high-value="100" style="justify-content: center; align-items: center; align-self: center; min-width: 90%; -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); font-size: 30px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px; left: 5%;" />
            </ui:GroupBox>
            <ui:GroupBox style="flex-direction: row;">
                <ui:Slider name="MusicSlider" label="MUSIC VOLUME" value="100" high-value="100" style="justify-content: center; align-items: center; align-self: center; min-width: 90%; -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); font-size: 30px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px; left: 5%;" />
            </ui:GroupBox>
            <ui:GroupBox style="flex-direction: row;">
                <ui:Slider name="SFXSlider" label="SFX VOLUME" value="100" high-value="100" style="justify-content: center; align-items: center; align-self: center; min-width: 90%; -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); font-size: 30px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px; left: 5%;" />
            </ui:GroupBox>
            <ui:GroupBox style="flex-direction: row;">
                <ui:Slider name="UiSlider" label="UI VOLUME" value="100" high-value="100" style="justify-content: center; align-items: center; align-self: center; min-width: 90%; -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); font-size: 30px; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1px; left: 5%;" />
            </ui:GroupBox>
        </ui:ScrollView>
        <ui:Button text="BACK TO MENU" selectable="false" name="BackButton" focusable="false" enabled="true" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); font-size: 30px; color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px; width: 281px; white-space: nowrap; -unity-text-align: lower-center; text-overflow: clip; left: auto; right: auto; position: relative; top: auto; bottom: auto; align-items: auto; justify-content: flex-start; align-self: center; align-content: auto; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; background-color: rgba(255, 255, 255, 0.63); letter-spacing: 10px; word-spacing: 0; background-position-x: center; background-position-y: center; height: 64px; padding-left: 12px;" />
    </ui:GroupBox>
</ui:UXML>
