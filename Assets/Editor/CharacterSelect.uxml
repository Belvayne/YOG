    <ui:Button text="CONFIRM CHARACTER" selectable="false" name="CharacterConfirmButton" focusable="false" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); font-size: 49px; color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px; width: auto; white-space: normal; -unity-text-align: upper-center; text-overflow: clip; left: auto; right: auto; position: relative; top: auto; bottom: auto; align-items: auto; justify-content: flex-start; align-self: center; align-content: auto; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; background-color: rgba(255, 255, 255, 0.63); letter-spacing: 10px; word-spacing: 0; background-position-x: center; background-position-y: center; height: auto; padding-left: 12px; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; margin-top: 2.5%; margin-bottom: 2.5%;" />
