        <ui:Button name="InaButton" enabled="true" class="character-button" style="display: flex; background-image: url(&quot;project://database/Assets/Images/InaPortrait.png?fileID=2800000&amp;guid=232ef102d4227c34c8004f936965f2d2&amp;type=3#InaPortrait&quot;); background-position-x: right 52.5%; background-position-y: top 25%;" />
