<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox name="PauseMenu" text="GAME PAUSED" enabled="true" style="top: 20%; height: 40%; position: relative; left: 40%; width: 20%; font-size: 40px; -unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 2px; -unity-text-align: upper-center; border-top-width: 5px; border-right-width: 3px; border-bottom-width: 5px; border-left-width: 3px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; background-color: rgba(255, 255, 255, 0.08); margin-top: 2px; padding-top: 20px; padding-left: 10px; padding-right: 10px; padding-bottom: 20px; bottom: auto;">
        <ui:Button text="RESUME GAME" double-click-selects-word="false" triple-click-selects-line="false" name="ResumeButton" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); font-size: 30px; background-color: rgba(255, 255, 255, 0.24); -unity-text-align: lower-center; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; -unity-font-style: bold; white-space: nowrap; text-overflow: clip; letter-spacing: 0; background-size: 100% 100%; justify-content: flex-end; align-content: flex-end; align-self: auto; align-items: center; margin-top: 5px; margin-bottom: 5px; margin-right: 5px; margin-left: 5px;" />
        <ui:Button text="SETTINGS" double-click-selects-word="false" triple-click-selects-line="false" name="SettingsButton" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); font-size: 30px; background-color: rgba(255, 255, 255, 0.24); -unity-text-align: lower-center; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; -unity-font-style: bold; white-space: nowrap; text-overflow: clip; letter-spacing: 0; background-size: 100% 100%; justify-content: flex-end; align-content: flex-end; align-self: auto; align-items: center; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;" />
        <ui:Button text="RESTART LEVEL" double-click-selects-word="false" triple-click-selects-line="false" name="RestartButton" style="-unity-font-definition: resource(&apos;Fonts &amp; Materials/LuckiestGuy-Regular&apos;); color: rgb(109, 229, 255); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); font-size: 30px; background-color: rgba(255, 255, 255, 0.24); -unity-text-align: lower-center; background-position-y: center; -unity-background-scale-mode: stretch-to-fill; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(109, 229, 255); border-right-color: rgb(109, 229, 255); border-top-color: rgb(109, 229, 255); border-bottom-color: rgb(109, 229, 255); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; -unity-font-style: bold; white-space: nowrap; text-overflow: clip; letter-spacing: 0; background-size: 100% 100%; justify-content: flex-end; align-content: flex-end; align-self: auto; align-items: center; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;" />
